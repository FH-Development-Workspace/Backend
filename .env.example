# ============================================
# FH Development API - Environment Configuration
# ============================================
# Copy this file to .env and fill in all required values
# DO NOT commit .env to version control

# ============================================
# Server Configuration
# ============================================
NODE_ENV=production
PORT=5000
RENDER=

# ============================================
# Database Configuration (MySQL)
# ============================================
# Option 1: Use connection string
DATABASE_URL=mysql://username:password@host:3306/database_name

# Option 2: Use individual variables (if not using DATABASE_URL)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Direct URL for some ORMs (if needed)
DIRECT_URL=

# ============================================
# Security & Authentication
# ============================================
# REQUIRED: Generate strong random secrets (32+ characters)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ============================================
# API URLs
# ============================================
API_BASE_URL=https://api.fh-development.xyz
FRONTEND_URL=https://fh-development.xyz
DASHBOARD_URL=https://dashboard.fh-development.xyz

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://fh-development.xyz,https://www.fh-development.xyz,https://dashboard.fh-development.xyz,https://dashboard.fh-developments.xyz,https://admin-dashboard.fh-development.xyz,https://staff-dashboard.fh-development.xyz,https://client-dashboard.fh-development.xyz,https://fh-development-workspace.github.io,https://fh-development-workspace.github.io/Frontend,https://fh-development-workspace.github.io/Dashboards,https://fh-development-workspace.github.io/Legal_Website

# ============================================
# Email Configuration (SMTP)
# ============================================
# REQUIRED for email functionality
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@fh-development.xyz
SMTP_FROM_NAME=FH Developments

# ============================================
# File Storage Configuration
# ============================================
STORAGE_PROVIDER=cloudinary
STORAGE_LOCAL_PATH=./uploads

# Cloudinary (if using cloudinary provider)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fh-development

# S3/Other (if using alternative provider)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# ============================================
# Roblox Vault Integration (Optional)
# ============================================
VAULT_API_BASE_URL=https://api.vaultroblox.com
VAULT_DEVELOPER_KEY=
VAULT_ENABLED=false

# ============================================
# Database Seeding
# ============================================
# Set these to create initial admin user when running db:seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin

# ============================================
# OAuth Integration (Optional)
# ============================================
# Discord OAuth
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Roblox OAuth
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Upload Configuration
# ============================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
